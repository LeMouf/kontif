{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KONITIF current registry draft, schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ecosystem", "status", "components", "unknowns"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ecosystem": { "const": "KONITIF" },
    "status": { "const": "draft" },
    "unknowns": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "aliases", "kind", "family", "role", "membership", "repository", "revision", "license", "introducedOn", "retiredOn", "replacedBy", "dependencies", "evidence", "unknowns"],
        "properties": {
          "id": { "type": "string", "pattern": "^konitif:[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "kind": { "enum": ["package", "application", "service", "specification", "documentation", "tool"] },
          "family": { "enum": ["konitif", "workbench"] },
          "role": { "type": "string", "minLength": 1 },
          "membership": { "enum": ["included", "experimental", "deprecated", "replaced", "removed", "excluded"] },
          "repository": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "revision": {
            "type": "object", "additionalProperties": false,
            "required": ["version", "sourceCommit", "artifact"],
            "properties": {
              "version": { "type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
              "sourceCommit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
              "artifact": {
                "type": ["object", "null"], "additionalProperties": false,
                "required": ["url", "integrity"],
                "properties": {
                  "url": { "type": "string", "minLength": 1 },
                  "integrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]{86}==$" }
                }
              }
            }
          },
          "license": { "type": "string", "minLength": 1 },
          "introducedOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "retiredOn": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "replacedBy": { "type": ["string", "null"], "pattern": "^konitif:[a-z][a-z0-9-]*$" },
          "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^konitif:[a-z][a-z0-9-]*$" }, "uniqueItems": true },
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["claim", "url", "status"],
              "properties": {
                "claim": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "minLength": 1 },
                "status": { "enum": ["recorded", "unknown"] }
              }
            }
          },
          "unknowns": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  }
}
